VALOR_APPLICATION__ENVIRONMENT=local
VALOR_APPLICATION__DEBUG=false
VALOR_DATABASE__URL=postgresql+psycopg://valor:change-me@postgres:5432/valor
VALOR_DATABASE__POOL_SIZE=5
VALOR_DATABASE__MAX_OVERFLOW=10
VALOR_DATABASE__POOL_TIMEOUT_SECONDS=30
VALOR_OBSERVABILITY__LOG_LEVEL=INFO
VALOR_OBSERVABILITY__LOG_JSON=true
VALOR_PROVIDER__OPENAI_API_KEY=replace-with-openai-api-key
VALOR_PROVIDER__TIMEOUT_SECONDS=30
VALOR_PRICING__ENTRIES=[{"provider":"openai","provider_model_reference":"gpt-test","pricing_version":"development-synthetic-v1","price_basis_units":1000000,"input_price_per_basis":"2.000000000000","output_price_per_basis":"8.000000000000","currency":"USD"}]
VALOR_TENANT_BUDGETS__ENTRIES=[{"tenant_id":"11111111-1111-4111-8111-111111111111","daily_estimated_cost_budget":"1.000000000000","per_invocation_cost_allowance":"0.250000000000","currency":"USD"}]
VALOR_SECURITY__MANAGEMENT_PRINCIPAL_ID=replace-with-stable-management-principal-id
VALOR_SECURITY__MANAGEMENT_TOKEN=replace-with-a-long-random-management-token
VALOR_SECURITY__MANAGEMENT_TENANT_IDS=["replace-with-an-authorized-tenant-uuid"]
VALOR_RUNTIME_AUTH__PRINCIPALS=[{"principal_id":"replace-with-runtime-principal-id","tenant_id":"replace-with-tenant-uuid","agent_id":"replace-with-agent-uuid","credential":"replace-with-a-distinct-long-random-runtime-token","usage_limit":100000,"per_invocation_allowance":1000}]
